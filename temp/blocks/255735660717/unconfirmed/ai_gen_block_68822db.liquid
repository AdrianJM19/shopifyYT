{% doc %}
  @prompt
    Dame una seccion de categorias estilo moderno de tecnologia 100% editable 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-tech-categories-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-tech-categories-container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-tech-categories-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: {{ block.settings.heading_spacing }}px;
  }

  .ai-tech-categories-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 12px;
    font-weight: 700;
  }

  .ai-tech-categories-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
    opacity: 0.9;
  }

  .ai-tech-categories-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: {{ block.settings.grid_gap }}px;
    margin-top: {{ block.settings.grid_spacing }}px;
  }

  .ai-tech-category-card-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.card_border_radius }}px;
    background: {{ block.settings.card_background }};
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    transition: all 0.3s ease;
    cursor: pointer;
    display: flex;
    flex-direction: column;
  }

  .ai-tech-category-card-{{ ai_gen_id }}:hover {
    transform: translateY(-{{ block.settings.hover_lift }}px);
    box-shadow: 0 {{ block.settings.hover_shadow_size }}px {{ block.settings.hover_shadow_size | times: 2 }}px {{ block.settings.hover_shadow_color }};
  }

  .ai-tech-category-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-top: {{ block.settings.image_aspect_ratio }}%;
    overflow: hidden;
    background: {{ block.settings.image_background }};
  }

  .ai-tech-category-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .ai-tech-category-card-{{ ai_gen_id }}:hover .ai-tech-category-image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-tech-category-content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .ai-tech-category-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.category_name_size }}px;
    color: {{ block.settings.category_name_color }};
    margin: 0 0 8px;
    font-weight: 600;
  }

  .ai-tech-category-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.category_description_size }}px;
    color: {{ block.settings.category_description_color }};
    margin: 0 0 16px;
    line-height: 1.5;
    flex-grow: 1;
  }

  .ai-tech-category-link-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: {{ block.settings.link_size }}px;
    color: {{ block.settings.link_color }};
    text-decoration: none;
    font-weight: 500;
    transition: gap 0.3s ease;
  }

  .ai-tech-category-card-{{ ai_gen_id }}:hover .ai-tech-category-link-{{ ai_gen_id }} {
    gap: 12px;
  }

  .ai-tech-category-icon-{{ ai_gen_id }} {
    width: 16px;
    height: 16px;
    transition: transform 0.3s ease;
  }

  .ai-tech-category-card-{{ ai_gen_id }}:hover .ai-tech-category-icon-{{ ai_gen_id }} {
    transform: translateX(4px);
  }

  .ai-tech-category-badge-{{ ai_gen_id }} {
    position: absolute;
    top: 16px;
    right: 16px;
    background: {{ block.settings.badge_background }};
    color: {{ block.settings.badge_text_color }};
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    z-index: 2;
  }

  .ai-tech-category-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: {{ block.settings.image_background }};
  }

  .ai-tech-category-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  @media screen and (max-width: 768px) {
    .ai-tech-categories-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: {{ block.settings.grid_gap | times: 0.75 }}px;
    }

    .ai-tech-categories-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-tech-category-content-{{ ai_gen_id }} {
      padding: {{ block.settings.card_padding | times: 0.75 }}px;
    }
  }
{% endstyle %}

<div class="ai-tech-categories-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-tech-categories-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.subtitle != blank %}
      <div class="ai-tech-categories-header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-tech-categories-title-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.subtitle != blank %}
          <p class="ai-tech-categories-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-tech-categories-grid-{{ ai_gen_id }}">
      {% for i in (1..6) %}
        {% liquid
          assign collection_key = 'category_' | append: i | append: '_collection'
          assign name_key = 'category_' | append: i | append: '_name'
          assign description_key = 'category_' | append: i | append: '_description'
          assign badge_key = 'category_' | append: i | append: '_badge'
          assign image_key = 'category_' | append: i | append: '_image'

          assign collection = block.settings[collection_key]
          assign custom_name = block.settings[name_key]
          assign description = block.settings[description_key]
          assign badge = block.settings[badge_key]
          assign custom_image = block.settings[image_key]

          if collection != blank
            assign category_url = collection.url
            assign category_name = collection.title
            assign category_image = collection.featured_image
          else
            assign category_url = '#'
            assign category_name = 'Categoría ' | append: i
            assign category_image = null
          endif

          if custom_name != blank
            assign category_name = custom_name
          endif

          if custom_image != blank
            assign category_image = custom_image
          endif
        %}

        <a href="{{ category_url }}" class="ai-tech-category-card-{{ ai_gen_id }}">
          <div class="ai-tech-category-image-wrapper-{{ ai_gen_id }}">
            {% if category_image %}
              <img
                src="{{ category_image | image_url: width: 600 }}"
                alt="{{ category_name | escape }}"
                loading="lazy"
                width="600"
                height="{{ 600 | times: block.settings.image_aspect_ratio | divided_by: 100 }}"
                class="ai-tech-category-image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-tech-category-placeholder-{{ ai_gen_id }}">
                {{ 'collection-1' | placeholder_svg_tag }}
              </div>
            {% endif %}

            {% if badge != blank %}
              <div class="ai-tech-category-badge-{{ ai_gen_id }}">{{ badge }}</div>
            {% endif %}
          </div>

          <div class="ai-tech-category-content-{{ ai_gen_id }}">
            <h3 class="ai-tech-category-name-{{ ai_gen_id }}">{{ category_name }}</h3>
            
            {% if description != blank %}
              <p class="ai-tech-category-description-{{ ai_gen_id }}">{{ description }}</p>
            {% endif %}

            <span class="ai-tech-category-link-{{ ai_gen_id }}">
              {{ block.settings.link_text }}
              <svg class="ai-tech-category-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </span>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</div>

