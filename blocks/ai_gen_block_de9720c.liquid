        },
        {
          "value": "cover",
          "label": "Cubrir"
        }
      ],
      "default": "contain"
    },
    {
      "type": "color",
      "id": "image_background",
      "label": "Fondo de imagen",
      "default": "#f9f9f9"
    },
    {
      "type": "header",
      "content": "Título del producto"
    },
    {
      "type": "range",
      "id": "product_title_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Tamaño",
      "default": 16
    },
    {
      "type": "color",
      "id": "product_title_color",
      "label": "Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "product_title_hover_color",
      "label": "Color al pasar el cursor",
      "default": "#666666"
    },
    {
      "type": "select",
      "id": "product_title_weight",
      "label": "Peso de fuente",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medio"
        },
        {
          "value": "600",
          "label": "Semi-negrita"
        },
        {
          "value": "700",
          "label": "Negrita"
        }
      ],
      "default": "500"
    },
    {
      "type": "range",
      "id": "title_spacing",
      "min": 5,
      "max": 20,
      "step": 1,
