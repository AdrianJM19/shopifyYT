{% schema %}
{
  "name": "Alienware Master Tab",
  "settings": [
    { "type": "header", "content": "OPCIÓN 1 (Izquierda)" },
    { "type": "text", "id": "title_1", "label": "Título 1", "default": "AREA-51" },
    { "type": "collection", "id": "collection_1", "label": "Colección 1" },
    { "type": "color", "id": "color_1", "label": "Color Activo 1", "default": "#3b0087" },
    
    { "type": "header", "content": "OPCIÓN 2 (Derecha)" },
    { "type": "text", "id": "title_2", "label": "Título 2", "default": "AURORA" },
    { "type": "collection", "id": "collection_2", "label": "Colección 2" },
    { "type": "color", "id": "color_2", "label": "Color Activo 2", "default": "#000000" },

    { "type": "range", "id": "limit", "min": 4, "max": 12, "step": 1, "label": "Productos a mostrar", "default": 4 }
  ],
  "presets": [
    { "name": "Alienware Master Tab" }
  ]
}
{% endschema %}

<style>
  /* CONTENEDOR GENERAL */
  .aw-master-container {
    max-width: 1400px;
    margin: 50px auto;
    padding: 0 20px;
  }

  /* --- 1. LAS TARJETAS (BOTONES GIGANTES) --- */
  .aw-cards-wrapper {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 40px;
  }

  .aw-card-trigger {
    position: relative;
    height: 450px;
    border-radius: 15px;
    overflow: hidden;
    cursor: pointer;
    transition: all 0.3s ease;
    border: 2px solid transparent; /* Borde invisible */
  }

  /* Estado INACTIVO (Grisáceo y un poco transparente) */
  .aw-card-trigger.inactive {
    filter: grayscale(80%);
    opacity: 0.7;
  }
  
  .aw-card-trigger.inactive:hover {
    filter: grayscale(0%);
    opacity: 1;
    transform: translateY(-5px);
  }

  /* Estado ACTIVO (Full color y borde) */
  .aw-card-trigger.active {
    filter: grayscale(0%);
    opacity: 1;
    box-shadow: 0 15px 40px rgba(0,0,0,0.4);
    transform: scale(1.01); /* Un pelín más grande */
    z-index: 2;
  }

  .aw-card-trigger img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .aw-overlay-gradient {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 60%;
    z-index: 2;
    transition: background 0.5s;
  }

  .aw-text-overlay {
    position: absolute;
    bottom: 20px;
    width: 100%;
    text-align: center;
    color: white;
    z-index: 3;
    font-family: sans-serif;
    text-transform: uppercase;
  }
  
  .aw-text-overlay h2 {
    font-size: 2.5rem;
    font-weight: 800;
    margin: 0;
    text-shadow: 0 2px 10px rgba(0,0,0,0.5);
  }

  /* --- 2. LOS PRODUCTOS (OCULTOS POR DEFECTO) --- */
  .aw-products-grid {
    display: none; /* Oculto */
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    animation: slideUp 0.5s ease;
  }

  /* Clase para mostrar el activo */
  .aw-products-grid.visible {
    display: grid;
  }

  @keyframes slideUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* TARJETA DE PRODUCTO */
  .aw-product-item {
    text-align: center;
    text-decoration: none;
    color: inherit;
    background: #fff;
    padding: 15px;
    border-radius: 8px;
    border: 1px solid #eee;
    transition: box-shadow 0.3s;
  }
  .aw-product-item:hover {
    box-shadow: 0 5px 15px rgba(0,0,0,0.1);
  }
  .aw-product-item img {
    width: 100%;
    height: 200px;
    object-fit: contain;
    margin-bottom: 10px;
  }
  .aw-p-title { font-weight: bold; font-size: 0.95rem; margin-bottom: 5px; display: block; }
  .aw-p-price { color: #666; font-size: 0.9rem; }

  /* MÓVIL */
  @media (max-width: 768px) {
    .aw-cards-wrapper { grid-template-columns: 1fr; }
    .aw-card-trigger { height: 250px; }
    .aw-products-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>

<div class="aw-master-container">

  <div class="aw-cards-wrapper">
    
    <div class="aw-card-trigger active" id="card-1" onclick="switchTab(1)">
      {% if section.settings.collection_1.image %}
        <img src="{{ section.settings.collection_1.image | image_url: width: 800 }}" loading="lazy">
      {% else %}
        {{ 'collection-1' | placeholder_svg_tag }}
      {% endif %}
      
      <div class="aw-overlay-gradient" style="background: linear-gradient(to top, {{ section.settings.color_1 }} 0%, transparent 100%);"></div>
      
      <div class="aw-text-overlay">
        <h2>{{ section.settings.title_1 }}</h2>
      </div>
    </div>

    <div class="aw-card-trigger inactive" id="card-2" onclick="switchTab(2)">
      {% if section.settings.collection_2.image %}
        <img src="{{ section.settings.collection_2.image | image_url: width: 800 }}" loading="lazy">
      {% else %}
        {{ 'collection-2' | placeholder_svg_tag }}
      {% endif %}
      
      <div class="aw-overlay-gradient" style="background: linear-gradient(to top, {{ section.settings.color_2 }} 0%, transparent 100%);"></div>

      <div class="aw-text-overlay">
        <h2>{{ section.settings.title_2 }}</h2>
      </div>
    </div>

  </div>

  <div class="aw-products-grid visible" id="grid-1">
    {% for product in section.settings.collection_1.products limit: section.settings.limit %}
      <a href="{{ product.url }}" class="aw-product-item">
        <img src="{{ product.featured_image | image_url: width: 400 }}" loading="lazy">
        <span class="aw-p-title">{{ product.title }}</span>
        <span class="aw-p-price">{{ product.price | money }}</span>
      </a>
    {% else %}
      <p>Agrega productos a la colección 1</p>
    {% endfor %}
  </div>

  <div class="aw-products-grid" id="grid-2">
    {% for product in section.settings.collection_2.products limit: section.settings.limit %}
      <a href="{{ product.url }}" class="aw-product-item">
        <img src="{{ product.featured_image | image_url: width: 400 }}" loading="lazy">
        <span class="aw-p-title">{{ product.title }}</span>
        <span class="aw-p-price">{{ product.price | money }}</span>
      </a>
    {% else %}
      <p>Agrega productos a la colección 2</p>
    {% endfor %}
  </div>

</div>

<script>
  function switchTab(id) {
    // 1. Manejo visual de las tarjetas (Gris vs Color)
    var card1 = document.getElementById('card-1');
    var card2 = document.getElementById('card-2');
    var grid1 = document.getElementById('grid-1');
    var grid2 = document.getElementById('grid-2');

    if(id === 1) {
      // Activar 1
      card1.classList.add('active');
      card1.classList.remove('inactive');
      grid1.classList.add('visible');

      // Desactivar 2
      card2.classList.remove('active');
      card2.classList.add('inactive');
      grid2.classList.remove('visible');
      
    } else {
      // Activar 2
      card2.classList.add('active');
      card2.classList.remove('inactive');
      grid2.classList.add('visible');

      // Desactivar 1
      card1.classList.remove('active');
      card1.classList.add('inactive');
      grid1.classList.remove('visible');
    }
  }
</script>