{% schema %}
{
  "name": "Alienware Master Tab",
  "settings": [
    { "type": "header", "content": "OPCIÓN 1 (Izquierda)" },
    { "type": "text", "id": "title_1", "label": "Título 1", "default": "AREA-51" },
    { "type": "text", "id": "desc_1", "label": "Subtítulo 1", "default": "Rendimiento extremo para jugadores." },
    { "type": "collection", "id": "collection_1", "label": "Colección 1" },
    { "type": "color", "id": "color_1", "label": "Color Activo 1", "default": "#3b0087" },
    
    { "type": "header", "content": "OPCIÓN 2 (Derecha)" },
    { "type": "text", "id": "title_2", "label": "Título 2", "default": "AURORA" },
    { "type": "text", "id": "desc_2", "label": "Subtítulo 2", "default": "Versatilidad total." },
    { "type": "collection", "id": "collection_2", "label": "Colección 2" },
    { "type": "color", "id": "color_2", "label": "Color Activo 2", "default": "#000000" },

    { "type": "range", "id": "limit", "min": 4, "max": 12, "step": 1, "label": "Productos a mostrar", "default": 4 }
  ],
  "presets": [
    { "name": "Alienware Master Tab" }
  ]
}
{% endschema %}

<style>
  .aw-master-container {
    max-width: 1400px;
    margin: 60px auto;
    padding: 0 20px;
  }

  /* --- ZONA DE TARJETAS (TRIGGERS) --- */
  .aw-cards-wrapper {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    margin-bottom: 50px;
  }

  /* Contenedor Clickable (Imagen + Texto Abajo) */
  .aw-option-container {
    cursor: pointer;
    text-align: center;
    transition: transform 0.3s ease;
  }

  .aw-option-container:hover {
    transform: translateY(-5px);
  }

  /* LA FOTO */
  .aw-card-image {
    position: relative;
    height: 350px;
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 25px; /* Espacio entre foto y texto */
    box-shadow: 0 10px 20px rgba(0,0,0,0.1);
    transition: all 0.4s ease;
    border-bottom: 5px solid transparent; /* Línea de color invisible por defecto */
  }

  .aw-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ESTADO INACTIVO (Gris) */
  .aw-option-container.inactive .aw-card-image {
    filter: grayscale(100%);
    opacity: 0.6;
  }

  /* ESTADO ACTIVO (Color) */
  .aw-option-container.active .aw-card-image {
    filter: grayscale(0%);
    opacity: 1;
    box-shadow: 0 15px 40px rgba(0,0,0,0.2);
  }

  /* TEXTO DEBAJO (Alienware Style) */
  .aw-text-group h2 {
    font-size: 2.2rem;
    font-weight: 800;
    margin: 0 0 8px 0;
    text-transform: uppercase;
    color: #111; /* Negro fuerte */
    letter-spacing: 0.5px;
    font-family: sans-serif;
  }

  .aw-text-group p {
    font-size: 1rem;
    color: #666; /* Gris suave */
    margin: 0 auto;
    max-width: 90%;
    line-height: 1.4;
  }

  /* --- ZONA DE PRODUCTOS --- */
  .aw-products-grid {
    display: none;
    grid-template-columns: repeat(4, 1fr);
    gap: 25px;
    padding-top: 30px;
    border-top: 1px solid #eee;
    animation: fadeIn 0.6s ease;
  }

  .aw-products-grid.visible {
    display: grid;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* ITEM PRODUCTO */
  .aw-product-item {
    text-align: center;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s;
    background: #fff;
    padding: 10px;
    border-radius: 8px;
  }
  .aw-product-item:hover { transform: translateY(-5px); box-shadow: 0 5px 15px rgba(0,0,0,0.05); }
  
  .aw-product-item img {
    width: 100%;
    height: 200px;
    object-fit: contain;
    margin-bottom: 15px;
    background: #f8f8f8;
    border-radius: 6px;
  }
  
  .aw-p-title { font-weight: bold; font-size: 0.95rem; display: block; margin-bottom: 5px; color: #333; }
  .aw-p-price { color: #555; font-size: 0.9rem; }

  /* MÓVIL */
  @media (max-width: 768px) {
    .aw-cards-wrapper { grid-template-columns: 1fr; gap: 40px; }
    .aw-card-image { height: 250px; }
    .aw-products-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>

<div class="aw-master-container">

  <div class="aw-cards-wrapper">
    
    <div class="aw-option-container active" id="opt-1" onclick="switchTab(1)">
      <div class="aw-card-image" id="img-1" style="border-bottom-color: {{ section.settings.color_1 }};">
        {% if section.settings.collection_1.image %}
          <img src="{{ section.settings.collection_1.image | image_url: width: 800 }}" loading="lazy">
        {% else %}
          {{ 'collection-1' | placeholder_svg_tag }}
        {% endif %}
      </div>
      <div class="aw-text-group">
        <h2>{{ section.settings.title_1 }}</h2>
        <p>{{ section.settings.desc_1 }}</p>
      </div>
    </div>

    <div class="aw-option-container inactive" id="opt-2" onclick="switchTab(2)">
      <div class="aw-card-image" id="img-2" style="border-bottom-color: {{ section.settings.color_2 }};">
        {% if section.settings.collection_2.image %}
          <img src="{{ section.settings.collection_2.image | image_url: width: 800 }}" loading="lazy">
        {% else %}
          {{ 'collection-2' | placeholder_svg_tag }}
        {% endif %}
      </div>
      <div class="aw-text-group">
        <h2>{{ section.settings.title_2 }}</h2>
        <p>{{ section.settings.desc_2 }}</p>
      </div>
    </div>

  </div>

  <div class="aw-products-grid visible" id="grid-1">
    {% for product in section.settings.collection_1.products limit: section.settings.limit %}
      <a href="{{ product.url }}" class="aw-product-item">
        <img src="{{ product.featured_image | image_url: width: 400 }}" loading="lazy">
        <span class="aw-p-title">{{ product.title }}</span>
        <span class="aw-p-price">{{ product.price | money }}</span>
      </a>
    {% else %}
      <p style="grid-column: 1 / -1; text-align: center; color: #888; padding: 20px;">
        ⚠️ La colección 1 está vacía.
      </p>
    {% endfor %}
  </div>

  <div class="aw-products-grid" id="grid-2">
    {% for product in section.settings.collection_2.products limit: section.settings.limit %}
      <a href="{{ product.url }}" class="aw-product-item">
        <img src="{{ product.featured_image | image_url: width: 400 }}" loading="lazy">
        <span class="aw-p-title">{{ product.title }}</span>
        <span class="aw-p-price">{{ product.price | money }}</span>
      </a>
    {% else %}
      <p style="grid-column: 1 / -1; text-align: center; color: #888; padding: 20px;">
        ⚠️ La colección 2 está vacía.
      </p>
    {% endfor %}
  </div>

</div>

<script>
  function switchTab(id) {
    var opt1 = document.getElementById('opt-1');
    var opt2 = document.getElementById('opt-2');
    var grid1 = document.getElementById('grid-1');
    var grid2 = document.getElementById('grid-2');

    if(id === 1) {
      // Activar 1
      opt1.classList.add('active');
      opt1.classList.remove('inactive');
      grid1.classList.add('visible');

      // Desactivar 2
      opt2.classList.remove('active');
      opt2.classList.add('inactive');
      grid2.classList.remove('visible');
    } else {
      // Activar 2
      opt2.classList.add('active');
      opt2.classList.remove('inactive');
      grid2.classList.add('visible');

      // Desactivar 1
      opt1.classList.remove('active');
      opt1.classList.add('inactive');
      grid1.classList.remove('visible');
    }
  }
</script>