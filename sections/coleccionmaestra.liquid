{% schema %}
{
  "name": "Alienware Tabs Final",
  "settings": [
    { "type": "header", "content": "PESTAÑA 1 (Izquierda)" },
    { "type": "text", "id": "title_1", "label": "Título 1", "default": "AREA-51" },
    { "type": "text", "id": "desc_1", "label": "Subtítulo 1", "default": "Rendimiento extremo." },
    { "type": "collection", "id": "collection_1", "label": "Colección 1" },
    { "type": "color", "id": "color_1", "label": "Color Activo 1", "default": "#58269e" },
    
    { "type": "header", "content": "PESTAÑA 2 (Derecha)" },
    { "type": "text", "id": "title_2", "label": "Título 2", "default": "AURORA" },
    { "type": "text", "id": "desc_2", "label": "Subtítulo 2", "default": "Versatilidad total." },
    { "type": "collection", "id": "collection_2", "label": "Colección 2" },
    { "type": "color", "id": "color_2", "label": "Color Activo 2", "default": "#005bd3" },

    { "type": "range", "id": "limit", "min": 4, "max": 12, "step": 1, "label": "Productos a mostrar", "default": 4 }
  ],
  "presets": [
    { "name": "Alienware Tabs Final" }
  ]
}
{% endschema %}

<style>
  .aw-master-container {
    max-width: 1400px;
    margin: 60px auto;
    padding: 0 20px;
  }

  /* --- ZONA DE TARJETAS (CONTROLES) --- */
  .aw-cards-wrapper {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
    margin-bottom: 50px;
  }

  /* El Contenedor Clickable */
  .aw-option-container {
    cursor: pointer;
    text-align: center;
    transition: transform 0.2s ease;
  }

  .aw-option-container:hover {
    transform: translateY(-3px); /* Pequeño movimiento al pasar mouse */
  }

  /* LA FOTO */
  .aw-card-image {
    position: relative;
    height: 350px;
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 20px;
    /* Quitamos el filtro gris. Siempre se ven bien */
    border-bottom: 0px solid transparent; 
    transition: all 0.3s ease;
  }

  .aw-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* --- LÓGICA DE ACTIVACIÓN --- */
  
  /* Cuando está ACTIVO */
  .aw-option-container.active .aw-card-image {
    /* Aquí aparece la barra de color abajo */
    border-bottom-width: 8px; 
    border-bottom-style: solid;
    /* El color se inyecta con JS */
    box-shadow: 0 10px 30px rgba(0,0,0,0.15);
  }

  /* El Texto del Título */
  .aw-text-group h2 {
    font-size: 2.2rem;
    font-weight: 800;
    margin: 0 0 5px 0;
    text-transform: uppercase;
    color: #333; /* Negro por defecto */
    transition: color 0.3s ease;
    font-family: sans-serif;
  }

  /* Cuando está ACTIVO, el texto cambia de color */
  .aw-option-container.active .aw-text-group h2 {
    /* El color se inyecta con JS */
  }

  .aw-text-group p {
    font-size: 1rem;
    color: #666;
    margin: 0;
  }

  /* --- ZONA DE PRODUCTOS --- */
  .aw-products-grid {
    display: none;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    padding-top: 30px;
    border-top: 1px solid #eee;
    animation: fadeIn 0.5s ease;
  }

  .aw-products-grid.visible {
    display: grid;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* ITEM PRODUCTO SIMPLE */
  .aw-product-item {
    text-align: center;
    text-decoration: none;
    color: inherit;
    background: white;
    padding: 15px;
    border-radius: 8px;
    transition: box-shadow 0.3s;
    border: 1px solid transparent;
  }
  .aw-product-item:hover {
    box-shadow: 0 5px 20px rgba(0,0,0,0.1);
    border-color: #eee;
  }
  
  .aw-product-item img {
    width: 100%;
    height: 180px;
    object-fit: contain;
    margin-bottom: 10px;
  }
  
  .aw-p-title { font-weight: bold; font-size: 0.9rem; display: block; margin-bottom: 5px; color: #333;}
  .aw-p-price { color: #666; font-size: 0.9rem; }

  @media (max-width: 768px) {
    .aw-cards-wrapper { grid-template-columns: 1fr; }
    .aw-card-image { height: 200px; }
    .aw-products-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>

<div class="aw-master-container">

  <div class="aw-cards-wrapper">
    
    <div class="aw-option-container active" id="opt-1" onclick="switchTab(1)">
      <div class="aw-card-image" id="img-1" style="border-color: {{ section.settings.color_1 }};">
        {% if section.settings.collection_1.image %}
          <img src="{{ section.settings.collection_1.image | image_url: width: 800 }}" loading="lazy">
        {% else %}
          {{ 'collection-1' | placeholder_svg_tag }}
        {% endif %}
      </div>
      <div class="aw-text-group">
        <h2 id="title-1" style="color: {{ section.settings.color_1 }};">{{ section.settings.title_1 }}</h2>
        <p>{{ section.settings.desc_1 }}</p>
      </div>
    </div>

    <div class="aw-option-container inactive" id="opt-2" onclick="switchTab(2)">
      <div class="aw-card-image" id="img-2" style="border-color: {{ section.settings.color_2 }};">
        {% if section.settings.collection_2.image %}
          <img src="{{ section.settings.collection_2.image | image_url: width: 800 }}" loading="lazy">
        {% else %}
          {{ 'collection-2' | placeholder_svg_tag }}
        {% endif %}
      </div>
      <div class="aw-text-group">
        <h2 id="title-2" style="color: #333;">{{ section.settings.title_2 }}</h2>
        <p>{{ section.settings.desc_2 }}</p>
      </div>
    </div>

  </div>

  <div class="aw-products-grid visible" id="grid-1">
    {% for product in section.settings.collection_1.products limit: section.settings.limit %}
      <a href="{{ product.url }}" class="aw-product-item">
        <img src="{{ product.featured_image | image_url: width: 400 }}" loading="lazy">
        <span class="aw-p-title">{{ product.title }}</span>
        <span class="aw-p-price">{{ product.price | money }}</span>
      </a>
    {% else %}
      <p style="grid-column: 1 / -1; text-align: center; color: #888;">⚠️ Colección vacía.</p>
    {% endfor %}
  </div>

  <div class="aw-products-grid" id="grid-2">
    {% for product in section.settings.collection_2.products limit: section.settings.limit %}
      <a href="{{ product.url }}" class="aw-product-item">
        <img src="{{ product.featured_image | image_url: width: 400 }}" loading="lazy">
        <span class="aw-p-title">{{ product.title }}</span>
        <span class="aw-p-price">{{ product.price | money }}</span>
      </a>
    {% else %}
      <p style="grid-column: 1 / -1; text-align: center; color: #888;">⚠️ Colección vacía.</p>
    {% endfor %}
  </div>

</div>

<script>
  // Variables de color desde Liquid a JS
  var color1 = "{{ section.settings.color_1 }}";
  var color2 = "{{ section.settings.color_2 }}";

  function switchTab(id) {
    var opt1 = document.getElementById('opt-1');
    var opt2 = document.getElementById('opt-2');
    var title1 = document.getElementById('title-1');
    var title2 = document.getElementById('title-2');
    var grid1 = document.getElementById('grid-1');
    var grid2 = document.getElementById('grid-2');

    if(id === 1) {
      // Activar 1
      opt1.classList.add('active');
      title1.style.color = color1; // Pintar Título
      grid1.classList.add('visible');

      // Desactivar 2
      opt2.classList.remove('active');
      title2.style.color = "#333"; // Despintar Título
      grid2.classList.remove('visible');
      
    } else {
      // Activar 2
      opt2.classList.add('active');
      title2.style.color = color2; // Pintar Título
      grid2.classList.add('visible');

      // Desactivar 1
      opt1.classList.remove('active');
      title1.style.color = "#333"; // Despintar Título
      grid1.classList.remove('visible');
    }
  }
</script>